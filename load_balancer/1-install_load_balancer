#!/usr/bin/env bash
# Install and configure HAProxy to distribute traffic between web servers

apt-get update -y
apt-get install -y haproxy

cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    log /dev/log local0
    log /dev/log local1 notice
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 35.177.153.101:80 check
    server web-02 3.8.174.101:80 check
EOF

systemctl enable haproxy
systemctl restart haproxy
