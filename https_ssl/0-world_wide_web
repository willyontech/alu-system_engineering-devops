#!/usr/bin/env bash
# Displays information about a domain's subdomains.

check_subdomain() {
    local domain=$1
    local subdomain=$2

    dig "$subdomain.$domain" | awk -v sub="$subdomain" '
    /ANSWER SECTION:/ {
        getline
        print "The subdomain " sub " is a " $4 " record and points to " $5
    }'
}

if [ "$#" -eq 2 ]; then
    check_subdomain "$1" "$2"
else
    for subdomain in www lb-01 web-01 web-02
    do
        check_subdomain "$1" "$subdomain"
    done
fi
